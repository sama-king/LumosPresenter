{
  "Urls": "http://0.0.0.0:5170",
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/server-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true,
          "flushToDiskInterval": "00:00:01",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Speech": {
    "Engine": "whisper",
    "Whisper": {
      // tiny.en is the shipped default so the packaged app runs on the weakest machine an
      // operator might install it on. Measured on a 15 W Intel i5-8365U: small.en runs 3.9x
      // slower than real time on CPU (2.9x with Vulkan) and can never catch up with a live
      // mic — the backlog grows for as long as anyone is speaking. base.en runs at 0.64x
      // with Vulkan, leaving headroom for a long sentence; tiny.en is faster still and
      // correspondingly less accurate. Operators on faster hardware can pick a larger model
      // from the console without a rebuild.
      "ModelPath": "models/whisper/ggml-tiny.en.bin",
      "Language": "en",
      "BiasPrompt": true
    },
    "Vad": {
      // RMS above which a frame counts as speech. The 0.01 default sat *below* the noise
      // floor of a typical laptop array mic (measured median 0.0113), so silence read as
      // speech, utterances never closed on a pause, and every chunk ran to the 8 s cap.
      // 0.03 sits about 4x above that noise floor and well under speech peaks (~0.18).
      // Adjustable per room from the console's Settings page.
      "EnergyThreshold": 0.03
    },
    "SherpaOnnx": {
      "EncoderPath": "models/sherpa-onnx/encoder.onnx",
      "DecoderPath": "models/sherpa-onnx/decoder.onnx",
      "JoinerPath": "models/sherpa-onnx/joiner.onnx",
      "TokensPath": "models/sherpa-onnx/tokens.txt",
      "NumThreads": 2
    }
  },
  "Parser": {
    "UtteranceWindow": 15
  },
  "Data": {
    "DatabasePath": "data/lumos.db",
    "SeedDirectory": "data/seed",
    "DefaultTranslation": "KJV"
  },
  "ApiBible": {
    "BaseUrl": "https://api.scripture.api.bible/v1/",
    "CacheDays": 14,
    "PrefetchRadius": 1,
    "BlockingTimeoutSeconds": 12,
    "Translations": {
      "NIV": {
        "BibleId": "78a9f6124f344018-01",
        "Name": "New International Version",
        "Language": "en"
      },
      "AMP": {
        "BibleId": "a81b73293d3080c9-01",
        "Name": "Amplified Bible",
        "Language": "en"
      },
      "MSG": {
        "BibleId": "6f11a7de016f942e-01",
        "Name": "The Message",
        "Language": "en"
      }
    }
  }
}
